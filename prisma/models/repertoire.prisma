model RepertoireItem {
  id         String   @id @default(cuid())
  title      String
  composer   String?
  collection String?
  externalId String?
  source     String   @default("MANUAL")
  category   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teacherLibraryItems TeacherLibraryItem[]

  @@index([title])
  @@index([source])
}

model TeacherLibraryItem {
  id               String         @id @default(cuid())
  teacherId        String
  teacher          User           @relation(fields: [teacherId], references: [id])
  repertoireItemId String
  repertoireItem   RepertoireItem @relation(fields: [repertoireItemId], references: [id])
  personalNotes    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  assignments StudentAssignment[]

  @@unique([teacherId, repertoireItemId])
  @@index([teacherId])
}

model StudentAssignment {
  id                   String             @id @default(cuid())
  studentId            String
  student              Student            @relation(fields: [studentId], references: [id])
  teacherLibraryItemId String
  teacherLibraryItem   TeacherLibraryItem @relation(fields: [teacherLibraryItemId], references: [id])
  instrumentId         String
  instrument           Instrument         @relation(fields: [instrumentId], references: [id])
  status               AssignmentStatus   @default(ACTIVE)
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  notes Note[]

  @@unique([studentId, teacherLibraryItemId, instrumentId])
  @@index([studentId])
  @@index([studentId, instrumentId])
}
